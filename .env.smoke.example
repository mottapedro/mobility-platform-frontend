# Copy to .env.smoke and fill in BEFORE running:
#   npx playwright test --project=smoke
#
# Smoke tests skip cleanly when these vars are missing.

# Backend API (single source of truth for both apps).
SMOKE_API_URL=https://staging-api.aliado.app

# Frontend URLs. Default to SMOKE_API_URL when unset (rarely correct).
SMOKE_PASSENGER_URL=https://staging-passenger.aliado.app
SMOKE_DRIVER_URL=https://staging-driver.aliado.app

# Dedicated seed accounts. NEVER reuse real users.
SMOKE_PASSENGER_EMAIL=smoke.passenger@aliado.app
SMOKE_PASSENGER_PASSWORD=change-me
SMOKE_DRIVER_EMAIL=smoke.driver@aliado.app
SMOKE_DRIVER_PASSWORD=change-me

# Ride payload defaults (optional).
SMOKE_ORIGIN=Av. Paulista, 1000, São Paulo
SMOKE_DESTINATION=Av. Brigadeiro Faria Lima, 3477, São Paulo
SMOKE_GEO_LAT=-23.5613
SMOKE_GEO_LNG=-46.6565
