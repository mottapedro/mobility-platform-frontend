{
  "name": "mobility-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:network": "playwright test e2e/network-tabs-no-offers.spec.ts --reporter=line",
    "test:e2e:smoke": "cross-env PLAYWRIGHT_SUITE=smoke playwright test --grep-invert @slow",
    "test:e2e:smoke:happy": "cross-env PLAYWRIGHT_SUITE=smoke playwright test e2e/smoke/smoke-happy-path.spec.ts",
    "test:e2e:smoke:nightly": "cross-env PLAYWRIGHT_SUITE=smoke playwright test",
    "test:e2e:godnetwork-smoke": "playwright test e2e/godnetwork-smoke",
    "test:e2e:godnetwork-governance": "playwright test e2e/godnetwork-governance",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "smoke": "ts-node --project tsconfig.scripts.json scripts/smoke.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "axios": "^1.17.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0"
  },
  "overrides": {
    "glob": "^13.0.0",
    "test-exclude": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.65.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "next-router-mock": "^1.0.5",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  }
}
